# ====================================================
# AJAYSINH FOUNDATION BACKEND ENVIRONMENT CONFIGURATION
# ====================================================

# Port
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Example local: mongodb://127.0.0.1:27017/ajaysinh_foundation
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/ajaysinh_foundation?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ajaysinh_foundation

# JWT Authentication Configuration
JWT_SECRET=ajaysinh_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (for seed script: npm run seed)
ADMIN_NAME=Ajaysinh Admin
ADMIN_EMAIL=admin@ajaysinhfoundation.org
ADMIN_PASSWORD=Admin@12345

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Optional - if online payment gateway is activated)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
